# AVSAR Root Environment Variables Example
# Duplicate this file to .env for local configuration

# Environment mode (development | staging | production)
NODE_ENV=development
ENVIRONMENT=development

# Backend Service URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Supabase Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/avsar_db
MONGODB_DB_NAME=avsar_db

# JWT & Authentication Secret
SECRET_KEY=your-super-secret-jwt-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Services (e.g. Gemini / OpenAI for extractor & resume parser)
GEMINI_API_KEY=your-gemini-api-key-here
