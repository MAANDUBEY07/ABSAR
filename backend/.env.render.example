ENVIRONMENT=production
AUTH_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_ATLAS_HOST/?retryWrites=true&w=majority
MONGODB_DATABASE=opportunityos
REDIS_URL=rediss://USER:PASSWORD@YOUR_REDIS_HOST:6379/0
JOBS_EAGER=false
REQUIRE_HUMAN_APPROVAL=true
DEMO_MODE=false
AWS_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_SERVER_ONLY_KEY
GEMINI_MODEL=SET_TO_A_MODEL_AVAILABLE_TO_YOUR_ACCOUNT
CORS_ORIGINS=["https://YOUR_PROJECT.vercel.app"]
MAX_UPLOAD_BYTES=5242880
RATE_LIMIT_PER_MINUTE=120
MATCH_WEIGHTS={"skills":0.40,"preferences":0.25,"experience":0.20,"learning":0.15}
DISCOVERY_FEEDS=[]
RESEND_API_KEY=
RESEND_FROM=
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_LANGUAGE_IDS={}
JUDGE0_ISOLATION_CONFIRMED=false
SENTRY_DSN=
OTEL_ENABLED=false
LOG_LEVEL=INFO
