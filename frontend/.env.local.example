# AVSAR Frontend Environment Variables Example

# Backend API Base URL (FastAPI /api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Required when backend auth_provider=supabase. These are browser-public Supabase settings;
# never put service-role keys or other private secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
